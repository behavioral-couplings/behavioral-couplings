# Copy to .env. Uncomment optional settings as needed.

# Gemini Developer API
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Alternative key; takes precedence.

# Vertex AI (instead of Developer API)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Hugging Face
# HF_TOKEN=

# Execution
# COUPLING_HOME=/absolute/path/to/behavioral_coupling
# PYTHON_BIN=python3
# DEEPSPEED_BIN=deepspeed
# CUDA_VISIBLE_DEVICES=0,1,2,3  # Training
# GPUS=0,1,2,3                 # Sampling
# GPU_MEMORY_BUDGET=0.9

# Judge
# JUDGE_MODEL_NAME=gemini-3.1-pro-preview
# JUDGE_PROVIDER=auto

# W&B (disabled by default)
# REPORT_TO=wandb
# WANDB_API_KEY=
# WANDB_PROJECT=behavioral-couplings
